<% layout('/layouts/boilerplate') %>


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />

<body class="bg-light">
  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-md-7 animate__animated animate__fadeInUp">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
          <!-- Image -->
          <img src="<%= list.image.url %>" class="card-img-top" alt="Listing image" style="height: 240px; object-fit: cover;" />

          <!-- Details -->
          <div class="card-body p-3">
            <h4 class="card-title text-primary mb-3 text-center">🏠 Listing Details</h4>

            <ul class="list-group list-group-flush mb-3">
              <li class="list-group-item"><strong>Owner:</strong> <%= list.owner.username %></li>
              <li class="list-group-item"><strong>Title:</strong> <%= list.title %></li>
              <li class="list-group-item"><strong>Description:</strong> <%= list.description %></li>
              <li class="list-group-item"><strong>Price:</strong> ₹ <%= list.price.toLocaleString('en-IN') %></li>
              <li class="list-group-item"><strong>Location:</strong> <%= list.location %></li>
              <li class="list-group-item"><strong>Country:</strong> <%= list.country %></li>
            </ul>

            <% if (currUser && currUser.equals(list.owner._id)) { %>
              <div class="d-flex gap-2 mb-4">
                <a href="/listings/<%= list._id %>/edit" class="btn btn-warning w-50 btn-sm">
                  <i class="fa fa-edit"></i> Edit
                </a>
                <form method="POST" action="/listings/<%= list._id %>?_method=delete" class="w-50">
                  <button type="submit" class="btn btn-danger w-100 btn-sm">
                    <i class="fa fa-trash"></i> Delete
                  </button>
                </form>
              </div>
            <% } %>

            <% if (currUser) { %>
              <h5 class="text-center mb-3">📝 Leave a Review</h5>
              <form method="post" action="/listings/<%= list._id %>/review" id="reviewForm">
                <div class="mb-3">
                  <label for="rating" class="form-label">Rating (1-5)</label>
                  <input type="number" class="form-control" id="rating" name="review[rating]" min="1" max="5" required>
                </div>
                <div class="mb-3">
                  <label for="comment" class="form-label">Comment</label>
                  <textarea class="form-control" id="comment" name="review[comment]" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100">Submit Review</button>
              </form>
            <% } %>

            <hr>
            <h3 class="text-center">💬 Reviews  </h3>
            <ul class="review-list">
              <% list.reviews.forEach((review, index) => { %>
                <li class="review-item <%= index % 2 === 0 ? 'left-align' : 'right-align' %> p-3 mb-3 border rounded position-relative bg-white shadow-sm">

                  <!-- Delete icon -->
                  <form action="/listings/<%= list._id %>/review/<%= review._id %>?_method=delete" method="POST" class="delete-form position-absolute top-0 end-0 m-2">
                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete Review">
                      <i class="fa fa-trash"></i>
                    </button>
                  </form>

                  <!-- Star Rating -->
                  <div class="mb-2">
                    <% for (let i = 0; i < review.rating; i++) { %>
                      <i class="fa fa-star text-warning"></i>
                    <% } %>
                    <% for (let i = review.rating; i < 5; i++) { %>
                      <i class="fa fa-star text-muted"></i>
                    <% } %>
                  </div>

                  <!-- Author & Comment -->
                  <p class="fw-bold mb-1">by <%= review.author.username %></p>
                  <p class="text-muted mb-0"><%= review.comment %></p>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>

      <!-- Map container -->
      <div class="col-12 mt-5">
        <h3 class="text-center">📍 Where you will be</h3>
        <div id="map" style="height: 300px;" class="rounded border"></div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script>
    document.getElementById('reviewForm')?.addEventListener('submit', function (e) {
      const rating = parseInt(document.getElementById('rating').value, 10);
      const comment = document.getElementById('comment').value.trim();

      if (isNaN(rating) || rating < 1 || rating > 5) {
        e.preventDefault();
        alert('Please enter a valid rating between 1 and 5.');
      } else if (comment.length < 3) {
        e.preventDefault();
        alert('Comment must be at least 3 characters long.');
      }
    });


  
  let token="<%= process.env.map_token %>";

    mapboxgl.accessToken = token;
    
    const map = new mapboxgl.Map({
      container: 'map',
      center: <%- JSON.stringify(coordinates) %>, // Adjust this to your desired location
      zoom: 9
    });
const marker1 = new mapboxgl.Marker()
        .setLngLat(<%- JSON.stringify(coordinates) %>)
        .setPopup(new mapboxgl.Popup({offset:25})

    .setHTML("<h3>Exact location</h3>")
    .setMaxWidth("300px"))
        .addTo(map);

     
  </script>


<script src="./public/js/script.js"></script>
</body>

<style>
  /* Timeline vertical center line */
  .review-list {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .review-list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: #e0e0e0;
    transform: translateX(-50%);
  }

  /* Review items */
  .review-item {
    width: 45%;
    border-radius: 0.75rem;
    opacity: 0;
    animation: fadeInUp 0.6s forwards;
    transition: transform 0.2s ease-in-out;
  }
  .review-item.left-align {
    left: 0;
    transform-origin: right;
  }
  .review-item.right-align {
    left: 55%;
    transform-origin: left;
  }
  .review-item:hover {
    transform: scale(1.03);
  }

  /* Delete button on hover */
  .delete-form {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .review-item:hover .delete-form {
    opacity: 1;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 767px) {
    .review-list::before {
      left: 20px;
    }
    .review-item {
      width: calc(100% - 40px);
      left: 40px !important;
    }
  }
</style>

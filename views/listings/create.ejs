<% layout('/layouts/boilerplate') %>

<!-- Include Bootstrap + Animate.css -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
<link
  href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  rel="stylesheet"
/>

<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <form
          class="form-container shadow-lg p-4 rounded bg-white animate__animated animate__fadeInUp needs-validation"
          novalidate
          action="/listings/new"
          method="POST"
          enctype="multipart/form-data" 
        >
          <h2 class="text-center mb-4">Create New Listing 🏠</h2>

          <div class="mb-3">
            <input
              type="text"
              name="title"
              class="form-control"
              placeholder="Title (e.g., Ski Chalet in Aspen)"
              required
            />
            <div class="invalid-feedback">Please provide a title.</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          <div class="mb-3">
            <textarea
              name="description"
              rows="4"
              class="form-control"
              placeholder="Description"
              required
            ></textarea>
            <div class="invalid-feedback">Please provide a description.</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          



 <div class="mb-3">
            <input
              type="file"
              name="listing[image]"
              class="form-control"
              placeholder="Image URL"
              required
            />
           
            <div class="valid-feedback">Looks good!</div>
          </div>





          <div class="mb-3">
            <input
              type="number"
              name="price"
              class="form-control"
              placeholder="Price (e.g., 4000)"
              required
              min="1"
            />
            <div class="invalid-feedback">Please provide a valid price (min: 1).</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          <div class="mb-3">
            <input
              type="text"
              name="location"
              class="form-control"
              placeholder="Location (e.g., Aspen)"
              required
            />
            <div class="invalid-feedback">Please provide a location.</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          <div class="mb-4">
            <input
              type="text"
              name="country"
              class="form-control"
              placeholder="Country (e.g., United States)"
              required
            />
            <div class="invalid-feedback">Please provide a country.</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          <button
            type="submit"
            class="btn btn-primary w-100 animated-btn"
          >
            ➕ Add Listing
          </button>
        </form>
      </div>
    </div>
  </div>
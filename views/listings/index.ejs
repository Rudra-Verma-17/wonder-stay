<% layout('/layouts/boilerplate') %>

<!-- Ensure these styles are included in your <head> -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
/>

<body class="bg-light">
  <div class="container py-5">
    <h1 class="text-center mb-5 animate__animated animate__fadeInDown">
      All Listings
    </h1>

    <div class="row g-4">
      <% for (let list of allData) { %>
      <div class="col-md-3 animate__animated animate__fadeInUp">
        <div class="card shadow-sm h-100 d-flex flex-column">
          <a href="/listings/<%= list._id %>">
            <img
              src="<%= list.image.url %>"
              class="card-img-top"
              alt="listing image"
              style="height: 200px; object-fit: cover;"
            />
          </a>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= list.title %></h5>
            <p class="card-text text-muted"><%= list.description %></p>

            <!-- Price and Location in the Same Axis (Same Line) -->
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="text-success fw-bold">₹<%= list.price %></span>
              <span class="text-muted"><%= list.location %></span>
            </div>

            <div class="mt-auto">
              <a
                href="/listings/<%= list._id %>"
                class="btn btn-primary w-100 mt-3"
              >
                View Details
              </a>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</body>

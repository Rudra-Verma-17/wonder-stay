<!-- Custom Navbar CSS -->
<style>
  .custom-navbar {
    background: linear-gradient(to right, #fce4ec, #e3f2fd);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    padding: 20px 32px;
    border-radius: 0 0 20px 20px;
    transition: background 0.5s ease;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
  }

  .navbar-brand {
    font-weight: 700;
    font-size: 2rem;
    color: #1e88e5;
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .navbar-brand:hover {
    transform: scale(1.05);
  }

  .navbar-brand i {
    margin-right: 10px;
  }

  .animated-link {
    position: relative;
    font-size: 1.1rem;
    color: #333;
    margin-left: 24px;
    padding-top: 6px;
    padding-bottom: 6px;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .animated-link:hover {
    color: #1e88e5;
  }

  .animated-link::after {
    content: "";
    position: absolute;
    width: 0%;
    height: 2px;
    left: 0;
    bottom: -3px;
    background-color: #1e88e5;
    transition: width 0.3s ease-in-out;
  }

  .animated-link:hover::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .navbar-nav .nav-link {
      margin-left: 0;
      padding: 10px;
      text-align: center;
    }

    .custom-navbar {
      border-radius: 0;
      padding: 16px;
    }

    .navbar-brand {
      font-size: 1.6rem;
    }
  }
</style>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

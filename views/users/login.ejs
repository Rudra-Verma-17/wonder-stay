<% layout('/layouts/boilerplate', { title: 'Login' }) %>

<div class="d-flex align-items-center justify-content-center min-vh-100" style="background: linear-gradient(135deg, #6f42c1, #007bff);">
  <div class="col-12 col-md-6 col-lg-4 animate__animated animate__fadeInDown">
    <div class="card shadow-xl border-0 rounded-4">
      <div class="card-body p-4">
        <h3 class="text-center mb-4 text-primary fw-bold">Welcome Back</h3>
        <p class="text-center text-muted mb-4">Please log in to your account</p>

        <form action="login" method="post">
          <!-- Username -->
          <div class="form-floating mb-3">
            <input 
              type="text" 
              class="form-control" 
              id="username" 
              name="username" 
              placeholder="Username" 
              required
            />
            <label for="username">Username</label>
          </div>

          <!-- Password -->
          <div class="form-floating mb-4">
            <input 
              type="password" 
              class="form-control" 
              id="password" 
              name="password" 
              placeholder="Password" 
              required
            />
            <label for="password">Password</label>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm">
            Log In
          </button>
        </form>

        <!-- Sign up Link -->
        <div class="mt-4 text-center">
          <span class="text-muted">Don't have an account?</span>
          <a href="/signup" class="text-decoration-none fw-medium text-primary">Sign up</a>
        </div>
      </div>
    </div>
  </div>
</div>
